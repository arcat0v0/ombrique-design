{
  "name": "ombrique-design",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ombrique/desktop dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "biome check .",
    "fix": "biome check --write .",
    "start": "pnpm --filter @ombrique/desktop start",
    "build": "pnpm --filter @ombrique/desktop build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "typescript": "^5.9.3"
  }
}
